<UserControl x:Class="ClipFlow.Views.SettingsView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled">
        <StackPanel Spacing="12" Padding="0,0,4,16">
            <Border Style="{StaticResource SettingCardStyle}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="180"/></Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Value, Source={StaticResource L_DisplayLanguage}}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <ComboBox x:Name="LanguageBox" Grid.Column="1" SelectedIndex="{Binding LanguageIndex}" SelectionChanged="Language_Changed" IsEnabled="{Binding CanChangeLanguage}" VerticalAlignment="Center" HorizontalAlignment="Stretch" AutomationProperties.Name="{Binding Value, Source={StaticResource L_DisplayLanguage}}">
                        <ComboBoxItem Content="{Binding Value, Source={StaticResource L_FollowSystem}}"/>
                        <ComboBoxItem Content="简体中文"/>
                        <ComboBoxItem Content="繁體中文"/>
                        <ComboBoxItem Content="English"/>
                    </ComboBox>
                </Grid>
            </Border>
            <TextBlock Text="{Binding Value, Source={StaticResource L_Appearance}}" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,16,0,4"/>
            <Border Style="{StaticResource SettingCardStyle}">
                <Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="180"/></Grid.ColumnDefinitions>
                    <StackPanel Spacing="4"><TextBlock Text="{Binding Value, Source={StaticResource L_AppTheme}}" FontWeight="SemiBold"/><TextBlock Text="{Binding Value, Source={StaticResource L_ThemeHelp}}" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel>
                    <ComboBox Grid.Column="1" SelectedIndex="{Binding ThemeIndex, Mode=TwoWay}" SelectionChanged="Theme_Changed" IsEnabled="{Binding IsReady}" VerticalAlignment="Center" HorizontalAlignment="Stretch" AutomationProperties.Name="{Binding Value, Source={StaticResource L_AppTheme}}">
                        <ComboBoxItem Content="{Binding Value, Source={StaticResource L_FollowSystem}}"/><ComboBoxItem Content="{Binding Value, Source={StaticResource L_Light}}"/><ComboBoxItem Content="{Binding Value, Source={StaticResource L_Dark}}"/>
                    </ComboBox>
                </Grid>
            </Border>
            <Border Style="{StaticResource SettingCardStyle}">
                <Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="180"/></Grid.ColumnDefinitions>
                    <StackPanel Spacing="4"><TextBlock Text="{Binding Value, Source={StaticResource L_Background}}" FontWeight="SemiBold"/><TextBlock Text="{Binding Value, Source={StaticResource L_BackgroundHelp}}" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel>
                    <ComboBox x:Name="BackdropBox" Grid.Column="1" SelectedIndex="{Binding BackdropIndex, Mode=TwoWay}" SelectionChanged="Backdrop_Changed" IsEnabled="{Binding IsReady}" VerticalAlignment="Center" HorizontalAlignment="Stretch" AutomationProperties.Name="{Binding Value, Source={StaticResource L_Background}}">
                        <ComboBoxItem Content="{Binding Value, Source={StaticResource L_SolidBackground}}"/><ComboBoxItem Content="{Binding Value, Source={StaticResource L_SubtleMica}}"/><ComboBoxItem Content="{Binding Value, Source={StaticResource L_StandardMica}}"/><ComboBoxItem Content="{Binding Value, Source={StaticResource L_StrongMica}}"/>
                    </ComboBox>
                </Grid>
            </Border>
            <TextBlock Text="{Binding Value, Source={StaticResource L_Shortcuts}}" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,16,0,4"/>
            <Border Style="{StaticResource SettingCardStyle}">
                <StackPanel Spacing="10">
                    <TextBlock Text="{Binding Value, Source={StaticResource L_PanelShortcut}}" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding ShortcutLabel}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <TextBlock Text="{Binding Value, Source={StaticResource L_PanelShortcutHelp}}" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <ComboBox x:Name="ShortcutModifiers" SelectedIndex="0" AutomationProperties.Name="{Binding Value, Source={StaticResource L_ShortcutModifiers}}">
                            <ComboBoxItem Content="Alt" Tag="1"/><ComboBoxItem Content="Ctrl" Tag="2"/><ComboBoxItem Content="Ctrl + Alt" Tag="3"/><ComboBoxItem Content="Alt + Shift" Tag="5"/><ComboBoxItem Content="Ctrl + Shift" Tag="6"/><ComboBoxItem Content="Ctrl + Alt + Shift" Tag="7"/>
                        </ComboBox>
                        <ComboBox x:Name="ShortcutKey" MinWidth="76" AutomationProperties.Name="{Binding Value, Source={StaticResource L_ShortcutKey}}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="{Binding Value, Source={StaticResource L_Save}}" Click="Shortcut_Save" IsEnabled="{Binding IsReady}"/>
                        <Button Content="{Binding Value, Source={StaticResource L_RestoreDefaultShortcut}}" Click="Shortcut_Reset" IsEnabled="{Binding IsReady}"/>
                    </StackPanel>
                    <TextBlock Text="{Binding ShortcutStatus}" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" AutomationProperties.LiveSetting="Polite"/>
                </StackPanel>
            </Border>
            <TextBlock Text="{Binding Value, Source={StaticResource L_Startup}}" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,16,0,4"/>
            <Border Style="{StaticResource SettingCardStyle}">
                <Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel Spacing="4"><TextBlock Text="{Binding Value, Source={StaticResource L_LaunchAtSignIn}}" FontWeight="SemiBold"/><TextBlock Text="{Binding StartupDescription}" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel>
                    <ToggleSwitch x:Name="StartupToggle" Grid.Column="1" IsOn="{Binding StartupEnabled, Mode=TwoWay}" IsEnabled="{Binding CanChangeStartup}" Toggled="Startup_Toggled" OnContent="{Binding Value, Source={StaticResource L_Enabled}}" OffContent="{Binding Value, Source={StaticResource L_Disabled}}" VerticalAlignment="Center" AutomationProperties.Name="{Binding Value, Source={StaticResource L_LaunchAtSignIn}}"/>
                </Grid>
            </Border>
            <TextBlock Text="{Binding Value, Source={StaticResource L_ClipboardItems}}" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,16,0,4"/>
            <Border Style="{StaticResource SettingCardStyle}">
                <Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel Spacing="4"><TextBlock Text="{Binding Value, Source={StaticResource L_RecordClipboard}}" FontWeight="SemiBold"/><TextBlock Text="{Binding Value, Source={StaticResource L_RecordClipboardHelp}}" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel>
                    <ToggleSwitch Grid.Column="1" IsOn="{Binding RecordingEnabled, Mode=TwoWay}" IsEnabled="{Binding IsReady}" Toggled="Recording_Toggled" OnContent="{Binding Value, Source={StaticResource L_Enabled}}" OffContent="{Binding Value, Source={StaticResource L_Paused}}" VerticalAlignment="Center" AutomationProperties.Name="{Binding Value, Source={StaticResource L_EnableRecording}}"/>
                </Grid>
            </Border>
            <Border Style="{StaticResource SettingCardStyle}">
                <Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="160"/></Grid.ColumnDefinitions>
                    <StackPanel Spacing="4"><TextBlock Text="{Binding Value, Source={StaticResource L_HistoryLimit}}" FontWeight="SemiBold"/><TextBlock Text="{Binding Value, Source={StaticResource L_HistoryLimitHelp}}" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel>
                    <NumberBox Grid.Column="1" Value="{Binding HistoryLimitValue, Mode=TwoWay}" IsEnabled="{Binding IsReady}" Minimum="10" Maximum="10000" SmallChange="10" SpinButtonPlacementMode="Compact" ValueChanged="Limit_Changed" VerticalAlignment="Center" AutomationProperties.Name="{Binding Value, Source={StaticResource L_HistoryLimitInput}}"/>
                </Grid>
            </Border>
            <TextBlock Text="{Binding Value, Source={StaticResource L_DataManagement}}" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,16,0,4"/>
            <Border Style="{StaticResource SettingCardStyle}">
                <StackPanel Spacing="14">
                    <TextBlock Text="{Binding Value, Source={StaticResource L_DataOnDeviceHeading}}" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding Value, Source={StaticResource L_DataOnDeviceHelp}}" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <Button Content="{Binding Value, Source={StaticResource L_ClearHistoryAction}}" Command="{Binding ClearHistoryCommand}" IsEnabled="{Binding CanClearHistory}" HorizontalAlignment="Left"/>
                    <Button Content="{Binding Value, Source={StaticResource L_ClearAllAction}}" Command="{Binding ClearDataCommand}" HorizontalAlignment="Left"/>
                    <TextBlock Text="{Binding Value, Source={StaticResource L_ClearDataHelp}}" TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <TextBlock Text="{Binding Value, Source={StaticResource L_DatabaseRecoveryHelp}}" TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Visibility="{Binding RetryVisibility}"/>
                </StackPanel>
            </Border>
            <TextBlock Text="{Binding Value, Source={StaticResource L_About}}" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,16,0,4"/>
            <Border Style="{StaticResource SettingCardStyle}">
                <StackPanel Spacing="8"><TextBlock Text="ClipFlow" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="{Binding AboutVersion}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/><TextBlock Text="{Binding AboutAuthor}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
