<UserControl x:Class="ClipFlow.Views.SettingsView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled">
        <StackPanel Spacing="12" Padding="0,0,4,16">
            <TextBlock Text="外观" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,0,0,4"/>
            <Border Style="{StaticResource SettingCardStyle}">
                <Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="180"/></Grid.ColumnDefinitions>
                    <StackPanel Spacing="4"><TextBlock Text="应用主题" FontWeight="SemiBold"/><TextBlock Text="选择熟悉的明暗外观。" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel>
                    <ComboBox Grid.Column="1" SelectedIndex="{Binding ThemeIndex}" SelectionChanged="Theme_Changed" IsEnabled="{Binding IsReady}" VerticalAlignment="Center" HorizontalAlignment="Stretch" AutomationProperties.Name="应用主题">
                        <ComboBoxItem Content="跟随系统"/><ComboBoxItem Content="浅色"/><ComboBoxItem Content="深色"/>
                    </ComboBox>
                </Grid>
            </Border>
            <TextBlock Text="剪贴板记录" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,16,0,4"/>
            <Border Style="{StaticResource SettingCardStyle}">
                <Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel Spacing="4"><TextBlock Text="记录剪贴板" FontWeight="SemiBold"/><TextBlock Text="暂停后停止收集，已有记录仍可查看。关闭窗口后在系统托盘继续运行，可从托盘菜单退出。" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel>
                    <ToggleSwitch Grid.Column="1" IsOn="{Binding RecordingEnabled}" IsEnabled="{Binding IsReady}" Toggled="Recording_Toggled" OnContent="已启用" OffContent="已暂停" VerticalAlignment="Center" AutomationProperties.Name="启用剪贴板记录"/>
                </Grid>
            </Border>
            <Border Style="{StaticResource SettingCardStyle}">
                <Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="160"/></Grid.ColumnDefinitions>
                    <StackPanel Spacing="4"><TextBlock Text="历史记录上限" FontWeight="SemiBold"/><TextBlock Text="10–10,000 条。超出时删除最旧记录（含收藏）。" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel>
                    <NumberBox Grid.Column="1" Value="{Binding HistoryLimit}" IsEnabled="{Binding IsReady}" Minimum="10" Maximum="10000" SmallChange="10" SpinButtonPlacementMode="Compact" ValueChanged="Limit_Changed" VerticalAlignment="Center" AutomationProperties.Name="历史记录数量上限"/>
                </Grid>
            </Border>
            <TextBlock Text="数据管理" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,16,0,4"/>
            <Border Style="{StaticResource SettingCardStyle}">
                <StackPanel Spacing="14">
                    <TextBlock Text="你的内容，留在你的设备" FontWeight="SemiBold"/>
                    <TextBlock Text="ClipFlow 不上传剪贴板内容。记录与图片仅保存在当前用户的本地应用数据目录。" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <Button Content="清空历史记录" Command="{Binding ClearHistoryCommand}" IsEnabled="{Binding CanClearHistory}" HorizontalAlignment="Left"/>
                    <Button Content="清空全部本地数据" Command="{Binding ClearDataCommand}" HorizontalAlignment="Left"/>
                    <TextBlock Text="清空历史会删除所有记录、收藏和图片。清空全部数据还会重置设置。两项操作均需确认。" TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <TextBlock Text="数据库初始化失败时，建议先备份本地数据目录；也可确认清空全部数据，恢复为空的数据库。" TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Visibility="{Binding RetryVisibility}"/>
                </StackPanel>
            </Border>
            <TextBlock Text="关于" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,16,0,4"/>
            <Border Style="{StaticResource SettingCardStyle}">
                <StackPanel Spacing="8"><TextBlock Text="ClipFlow" FontSize="20" FontWeight="SemiBold"/><TextBlock x:Name="AboutVersion" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/><TextBlock x:Name="AboutAuthor" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
