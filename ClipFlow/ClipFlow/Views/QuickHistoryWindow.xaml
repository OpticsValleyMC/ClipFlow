<Window x:Class="ClipFlow.Views.QuickHistoryWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:ClipFlow.Views">
    <Grid x:Name="Root" Padding="16,4,16,10" RowSpacing="8" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions><RowDefinition Height="28"/><RowDefinition Height="34"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="24"/></Grid.ColumnDefinitions>
            <Grid x:Name="DragRegion" Background="Transparent" ToolTipService.ToolTip="拖动浮窗">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"><FontIcon Glyph="&#xE77F;" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/><TextBlock Text="ClipFlow" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel>
            </Grid>
            <Button x:Name="CloseButton" Grid.Column="1" Click="Close_Click" Width="24" Height="24" MinWidth="0" MinHeight="0" Padding="0" Margin="0,-1,-12,0" VerticalAlignment="Top" HorizontalAlignment="Right" Background="Transparent" BorderThickness="0" AutomationProperties.Name="关闭浮窗" ToolTipService.ToolTip="关闭 · Esc"><FontIcon Glyph="&#xE8BB;" FontSize="10"/></Button>
        </Grid>
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
            <Grid>
                <Button x:Name="ClipboardTab" Click="ClipboardTab_Click" FontSize="12" MinHeight="28" Background="Transparent" BorderThickness="0" Padding="8,4" ToolTipService.ToolTip="全部记录"><StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE77F;" FontSize="14"/><TextBlock Text="剪贴板" FontWeight="SemiBold"/></StackPanel></Button>
                <Border x:Name="AllIndicator" Height="2" Width="18" CornerRadius="1" VerticalAlignment="Bottom" Background="{ThemeResource SystemControlHighlightAccentBrush}"/>
            </Grid>
            <Grid>
                <ToggleButton x:Name="FavoritesOnly" Checked="Favorites_Changed" Unchecked="Favorites_Changed" FontSize="12" MinHeight="28" Background="Transparent" BorderThickness="0" Padding="8,4" ToolTipService.ToolTip="收藏的记录" AutomationProperties.Name="只看收藏"><StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE734;" FontSize="14"/><TextBlock Text="收藏"/></StackPanel></ToggleButton>
                <Border x:Name="FavoriteIndicator" Height="2" Width="18" CornerRadius="1" VerticalAlignment="Bottom" Background="{ThemeResource SystemControlHighlightAccentBrush}" Visibility="Collapsed"/>
            </Grid>
        </StackPanel>
        <TextBox x:Name="SearchBox" Grid.Row="2" PlaceholderText="搜索剪贴板" TextChanged="Search_Changed" AutomationProperties.Name="搜索浮窗记录"/>
        <ListView x:Name="RecordsList" Grid.Row="3" Margin="0,0,-12,0" SelectionMode="Single" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="剪贴板记录">
            <ListView.Resources>
                <SolidColorBrush x:Key="ListViewItemBackgroundPointerOver" Color="Transparent"/>
                <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPointerOver" Color="Transparent"/>
                <SolidColorBrush x:Key="ListViewItemBackgroundPressed" Color="Transparent"/>
                <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPressed" Color="Transparent"/>
            </ListView.Resources>
            <ListView.ItemContainerStyle><Style TargetType="ListViewItem"><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,12,8"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="CornerRadius" Value="8"/></Style></ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" MinHeight="88">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="38"/></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="34"/></Grid.RowDefinitions>
                            <Button x:Name="PasteItem" Grid.RowSpan="2" Tag="{Binding}" Click="Paste_Click" Background="Transparent" BorderThickness="0" Padding="12" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" VerticalAlignment="Stretch" VerticalContentAlignment="Top" AutomationProperties.Name="粘贴此记录" ToolTipService.ToolTip="{Binding Timestamp}">
                                <Button.Resources>
                                    <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="Transparent"/>
                                    <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="Transparent"/>
                                    <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="Transparent"/>
                                    <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="Transparent"/>
                                </Button.Resources>
                                <StackPanel Spacing="6">
                                    <TextBlock Text="{Binding Preview}" local:SearchHighlight.Query="{Binding SearchQuery}" MaxLines="3" FontSize="14" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" Visibility="{Binding TextVisibility}"/>
                                    <StackPanel Visibility="{Binding ImageVisibility}" Spacing="6"><Image Source="{Binding Thumbnail}" Height="90" Stretch="Uniform" HorizontalAlignment="Left" Visibility="{Binding ImagePreviewVisibility}"/><TextBlock Text="图片无法加载" Visibility="{Binding ImageFailureVisibility}"/></StackPanel>
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="1" Width="30" Height="30" Padding="0" Margin="2,3,3,0" VerticalAlignment="Top" Background="Transparent" BorderThickness="0" AutomationProperties.Name="记录更多操作" ToolTipService.ToolTip="更多操作">
                                <FontIcon Glyph="&#xE712;" FontSize="14"/>
                                <Button.Flyout><MenuFlyout><MenuFlyoutItem Text="{Binding FavoriteLabel}" Tag="{Binding}" Click="Favorite_Click"><MenuFlyoutItem.Icon><FontIcon Glyph="{Binding FavoriteGlyph}"/></MenuFlyoutItem.Icon></MenuFlyoutItem><MenuFlyoutItem Text="删除" Tag="{Binding}" Click="Delete_Click"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xE74D;"/></MenuFlyoutItem.Icon></MenuFlyoutItem></MenuFlyout></Button.Flyout>
                            </Button>
                            <Button Grid.Column="1" Grid.Row="1" Width="30" Height="30" Padding="0" Margin="2,0,3,3" Tag="{Binding}" Click="Favorite_Click" Background="Transparent" BorderThickness="0" AutomationProperties.Name="{Binding FavoriteLabel}" ToolTipService.ToolTip="{Binding FavoriteLabel}"><FontIcon Glyph="{Binding FavoriteGlyph}" FontSize="15"/></Button>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
        <StackPanel x:Name="EmptyText" Grid.Row="3" Spacing="10" HorizontalAlignment="Center" VerticalAlignment="Center"><FontIcon Glyph="&#xE77F;" FontSize="32" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/><TextBlock x:Name="EmptyLabel" Text="暂无剪贴板记录" FontWeight="SemiBold" HorizontalAlignment="Center"/><TextBlock Text="复制文本或图片后，会显示在这里" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel>
        <TextBlock x:Name="StatusText" Grid.Row="4" Text="点击粘贴 · Esc 关闭" FontSize="11" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" AutomationProperties.LiveSetting="Polite"/>
    </Grid>
</Window>
