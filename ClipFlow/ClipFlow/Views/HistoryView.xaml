<UserControl x:Class="ClipFlow.Views.HistoryView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="using:ClipFlow.Views">
    <UserControl.Resources>
        <FontIconSource x:Key="RecordingIcon" Glyph="&#xE768;" Foreground="{ThemeResource SystemFillColorSuccessBrush}"/>
        <FontIconSource x:Key="PausedIcon" Glyph="&#xE769;" Foreground="{ThemeResource SystemFillColorCautionBrush}"/>
        <FontIconSource x:Key="UnavailableIcon" Glyph="&#xE7BA;" Foreground="{ThemeResource SystemFillColorCriticalBrush}"/>
    </UserControl.Resources>
    <Grid RowSpacing="16">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <InfoBar x:Name="RecordingStatus" IsOpen="True" IsClosable="False" Severity="{Binding RecordingSeverity}"
            Message="{Binding RecordingLabel}" IconSource="{StaticResource RecordingIcon}" AutomationProperties.LiveSetting="Polite">
            <InfoBar.ActionButton>
                <Button Content="{Binding RecordingButton}" Command="{Binding ToggleRecordingCommand}" IsEnabled="{Binding IsReady}" HorizontalAlignment="Right"/>
            </InfoBar.ActionButton>
        </InfoBar>
        <Grid Grid.Row="1" ColumnSpacing="12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="112"/></Grid.ColumnDefinitions>
            <TextBox Text="{Binding Search, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="{Binding SearchPlaceholder}" AutomationProperties.Name="{Binding SearchPlaceholder}"/>
            <ComboBox Grid.Column="1" SelectedIndex="{Binding TypeFilter, Mode=TwoWay}" HorizontalAlignment="Stretch" AutomationProperties.Name="内容类型">
                <ComboBoxItem Content="全部类型"/><ComboBoxItem Content="文本"/><ComboBoxItem Content="图片"/>
            </ComboBox>
        </Grid>
        <Grid Grid.Row="2">
            <TextBlock Text="{Binding CountLabel}" VerticalAlignment="Center" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            <Button x:Name="ClearHistoryButton" Content="清空历史" Command="{Binding ClearHistoryCommand}" HorizontalAlignment="Right" IsEnabled="{Binding CanClearHistory}" Visibility="{Binding ClearHistoryVisibility}"/>
            <ComboBox x:Name="FavoriteSortBox" SelectedIndex="{Binding FavoriteSortIndex, Mode=TwoWay}" HorizontalAlignment="Right" Width="168" Visibility="{Binding FavoritesVisibility}" IsEnabled="{Binding IsReady}" AutomationProperties.Name="收藏排序">
                <ComboBoxItem Content="最近复制优先"/><ComboBoxItem Content="最早复制优先"/><ComboBoxItem Content="按内容名称排序"/>
            </ComboBox>
        </Grid>
        <ListView x:Name="HistoryList" Grid.Row="3" ItemsSource="{Binding Records}" SelectionMode="None" IsItemClickEnabled="False"
            HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
            ScrollViewer.HorizontalScrollMode="Disabled" AutomationProperties.Name="剪贴板历史记录">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,0,12"/><Setter Property="IsTabStop" Value="False"/></Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemsPanel><ItemsPanelTemplate><ItemsStackPanel/></ItemsPanelTemplate></ListView.ItemsPanel>
            <ListView.ItemTemplate><DataTemplate><views:RecordCard/></DataTemplate></ListView.ItemTemplate>
        </ListView>
        <StackPanel Grid.Row="3" Visibility="{Binding EmptyVisibility}" VerticalAlignment="Center" HorizontalAlignment="Stretch" Spacing="14" Margin="20">
            <FontIcon Glyph="&#xE8C8;" FontSize="42" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center"/>
            <TextBlock Text="{Binding EmptyTitle}" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" TextAlignment="Center"/>
            <TextBlock x:Name="EmptyDescriptionText" Text="{Binding EmptyDescription}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" TextAlignment="Center"
                ToolTipService.ToolTip="{Binding EmptyDescription}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
        </StackPanel>
    </Grid>
</UserControl>
